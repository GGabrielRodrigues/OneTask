Thumbs.db
Desktop.ini
.directory

# Configurações de IDEs e Editores
.vscode/
.idea/
*.swp
*.swo

# Arquivos estáticos coletados (se usar collectstatic no futuro)
staticfiles/
collected_static/

# Media / Uploads locais (se houver no futuro)
media/
