# Ambientes Virtuais
venv/
env/
.env/
.venv/

# Variáveis de Ambiente e Segredos
.env
.env.local
.env.*

# Banco de Dados SQLite (ignorar para não commitar dados locais)
db.sqlite3
*.sqlite3

